/*
 * ESPAgent Build-time Secrets
 *
 * This is the ONLY way to configure ESPAgent.
 * Copy this file to espagent_secrets.h and fill in your values.
 * After any change, rebuild: idf.py fullclean && idf.py build
 *
 *   cp espagent_secrets.h.example espagent_secrets.h
 */

#pragma once

/* WiFi */
#define ESPAGENT_SECRET_WIFI_SSID       ""
#define ESPAGENT_SECRET_WIFI_PASS       ""

/* Feishu Bot */
#define ESPAGENT_SECRET_FEISHU_APP_ID   ""
#define ESPAGENT_SECRET_FEISHU_APP_SECRET ""

/* Anthropic API */
#define ESPAGENT_SECRET_API_KEY         ""
#define ESPAGENT_SECRET_MODEL           ""
#define ESPAGENT_SECRET_MODEL_PROVIDER  "anthropic"

/* HTTP Proxy (leave empty or set both) */
#define ESPAGENT_SECRET_PROXY_HOST      ""
#define ESPAGENT_SECRET_PROXY_PORT      ""
#define ESPAGENT_SECRET_PROXY_TYPE      ""   /* "http" or "socks5" */

/* Brave Search API */
#define ESPAGENT_SECRET_SEARCH_KEY      ""
/* Tavily Search API */
#define ESPAGENT_SECRET_TAVILY_KEY      ""

/* Amap WebService API for structured weather lookup.
 * Keep the key private. The default adcode below is Nanjing Qixia District.
 */
#define ESPAGENT_SECRET_AMAP_KEY        ""
#define ESPAGENT_SECRET_AMAP_DEFAULT_LOCATION "南京市栖霞区"
#define ESPAGENT_SECRET_AMAP_DEFAULT_ADCODE "320113"

/* LingShu Agent Mesh node identity.
 * ESP32-S3 currently acts as one edge agent node in the planned mesh.
 */
#define ESPAGENT_SECRET_NODE_ID "esp32s3-edge-01"
#define ESPAGENT_SECRET_NODE_ROLE "edge_agent"
#define ESPAGENT_SECRET_NODE_LOCATION "南京市栖霞区"
#define ESPAGENT_SECRET_MESH_TOPIC_PREFIX "espagent"
#define ESPAGENT_SECRET_NODE_CAPABILITIES "coordinator,communication,sensor,control,display,telemetry,timeline,alerts"
#define ESPAGENT_SECRET_NODE_RESPONSIBILITIES "single-node development profile; can chat, sense, control, publish telemetry, and display mesh state"

/* Four-ESP32 role examples:
 *
 * Coordinator / Communication node:
 *   ESPAGENT_SECRET_NODE_ID "esp32s3-coordinator-01"
 *   ESPAGENT_SECRET_NODE_ROLE "coordinator_agent"
 *   ESPAGENT_SECRET_NODE_CAPABILITIES "coordinator,communication,llm,dispatch,timeline,alerts"
 *
 * Sensor node:
 *   ESPAGENT_SECRET_NODE_ID "esp32s3-sensor-01"
 *   ESPAGENT_SECRET_NODE_ROLE "sensor_agent"
 *   ESPAGENT_SECRET_NODE_CAPABILITIES "sensor,telemetry,environment,air_quality,light,presence"
 *
 * Control node:
 *   ESPAGENT_SECRET_NODE_ID "esp32s3-control-01"
 *   ESPAGENT_SECRET_NODE_ROLE "control_agent"
 *   ESPAGENT_SECRET_NODE_CAPABILITIES "control,gpio,rgb,servo,relay,actuator"
 *
 * Display / watchdog node:
 *   ESPAGENT_SECRET_NODE_ID "esp32s3-display-01"
 *   ESPAGENT_SECRET_NODE_ROLE "display_agent"
 *   ESPAGENT_SECRET_NODE_CAPABILITIES "display,timeline,alerts,state,watchdog"
 */

/* Onboard RGB LED (change if your board uses a different WS2812 pin) */
#define ESPAGENT_SECRET_WS2812_GPIO     48

/* Servo motor (optional; defaults to GPIO 5 if unset) */
#define ESPAGENT_SECRET_SERVO_GPIO      5

/* DHT11 legacy sensor data pin (unused when AHT10 is enabled below) */
#define ESPAGENT_SECRET_DHT11_GPIO      3

/* AHT10 temperature/humidity sensor I2C wiring */
#define ESPAGENT_SECRET_AHT10_SDA_GPIO  21
#define ESPAGENT_SECRET_AHT10_SCL_GPIO  18
#define ESPAGENT_SECRET_AHT10_I2C_PORT  0
#define ESPAGENT_SECRET_AHT10_SCL_HZ    100000
#define ESPAGENT_SECRET_AHT10_ADDR      0x38

/* 3-wire human presence/PIR sensor OUT pin: VCC, GND, OUT */
#define ESPAGENT_SECRET_PRESENCE_GPIO   (-1)

/* HC-SR05 ultrasonic presence/proximity sensor.
 * Power the module from 5V, share GND, and protect Echo with a divider or level shifter before ESP32 input.
 * Leave pins as -1 to require per-call trig_gpio/echo_gpio overrides.
 */
#define ESPAGENT_SECRET_HC_SR05_TRIG_GPIO (-1)
#define ESPAGENT_SECRET_HC_SR05_ECHO_GPIO (-1)
#define ESPAGENT_SECRET_HC_SR05_PRESENT_THRESHOLD_CM 80

/* MQTT sensor / Agent Mesh pipe.
 * Leave broker empty to disable this background publisher.
 * Telemetry publishes to:
 *   espagent/nodes/<node_id>/telemetry
 * State publishes to:
 *   espagent/nodes/<node_id>/state
 */
#define ESPAGENT_SECRET_SENSOR_MQTT_BROKER ""
#define ESPAGENT_SECRET_SENSOR_MQTT_PORT 1883
#define ESPAGENT_SECRET_SENSOR_DHT22_GPIO 4
#define ESPAGENT_SECRET_SENSOR_MHZ19_UART_NUM 1
#define ESPAGENT_SECRET_SENSOR_MHZ19_RX_GPIO 16
#define ESPAGENT_SECRET_SENSOR_MHZ19_TX_GPIO 17
#define ESPAGENT_SECRET_SENSOR_MQTT_PUBLISH_INTERVAL_MS 5000

/* SGP30 hardware I2C1 wiring for 3-I2C combined tests */
#define ESPAGENT_SECRET_SGP30_SDA_GPIO  14
#define ESPAGENT_SECRET_SGP30_SCL_GPIO  15
#define ESPAGENT_SECRET_SGP30_I2C_PORT  1
#define ESPAGENT_SECRET_SGP30_SCL_HZ    100000

/* MAX98357 I2S audio amplifier wiring. */
#define ESPAGENT_SECRET_MAX98357_BCLK_GPIO 1
#define ESPAGENT_SECRET_MAX98357_WS_GPIO   2
#define ESPAGENT_SECRET_MAX98357_DIN_GPIO  3
#define ESPAGENT_SECRET_MAX98357_SD_GPIO   (-1)
#define ESPAGENT_SECRET_MAX98357_I2S_PORT  0
#define ESPAGENT_SECRET_MAX98357_SAMPLE_RATE_HZ 16000
#define ESPAGENT_SECRET_MAX98357_DEFAULT_TONE_HZ 440
#define ESPAGENT_SECRET_MAX98357_DEFAULT_DURATION_MS 2000
#define ESPAGENT_SECRET_MAX98357_DEFAULT_VOLUME_PCT 70

/* GY-30 / BH1750 software I2C wiring.
 * Default ADDR low/open address is 0x23; ADDR high is 0x5C.
 */
#define ESPAGENT_SECRET_BH1750_SDA_GPIO 11
#define ESPAGENT_SECRET_BH1750_SCL_GPIO 12
#define ESPAGENT_SECRET_BH1750_I2C_PORT 0
#define ESPAGENT_SECRET_BH1750_SCL_HZ   100000
#define ESPAGENT_SECRET_BH1750_ADDR     0x23
