# ESPAgent - Common Default Configuration
# Target-specific settings are in sdkconfig.defaults.esp32s3

# Optimize the application for flash footprint on memory-constrained nodes.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Network hostname
CONFIG_LWIP_LOCAL_HOSTNAME="espagent"
CONFIG_LWIP_MAX_SOCKETS=12
CONFIG_LWIP_MAX_ACTIVE_TCP=12
CONFIG_LWIP_MAX_LISTENING_TCP=12
CONFIG_LWIP_MAX_UDP_PCBS=12

# SPIFFS: increase max filename length (default 32 is too short for session files)
CONFIG_SPIFFS_OBJ_NAME_LEN=64

# FreeRTOS timer service task: keep enough stack for Wi-Fi/MQTT/WebSocket timer
# callbacks under Feishu-entry stress. Heavy app work should still be deferred
# out of timer callbacks.
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096
